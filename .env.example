APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# セッションは SQLite（sessions テーブル）に置かれ、バックアップにも入る。
# バリデーション失敗時の old input（貼り間違えた設定値など）が平文で残らないよう暗号化する
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# AI 実行先（codex サブプロセス）
#
# ⚠ どの用途をどの実行先で走らせるかは、アプリの「設定 → AIエンジン」から選ぶ。
#    このファイルには接続の上限秒だけを置く。
#
# codex 実行ファイルのパス。**通常は空のままでよい**（nvm 配下等から自動検出する）。
# 自動検出が外れる場所に置いている場合だけ `which codex` の出力を書く
# ─────────────────────────────────────────────────────────────
CODEX_BIN=
CODEX_TIMEOUT=180

# codex の使用モデル（CODEX_MODEL / CODEX_MODEL_LIGHT）は DB（ai_provider_configs の codex 行）に持つ。
# 旧 .env に書いてあった値は初回の `php artisan migrate` で codex 行にコピーされ、以後ここに書いても読まれない
# （変更は「設定 → AIエンジン」から。空なら codex の既定モデル）。
# ⚠ そのコピーは config キャッシュ中だと .env を読めないため、migrate は `php artisan config:clear` の後に実行する
#   （黙って空にはせず、エラーで止まる）

# ─────────────────────────────────────────────────────────────
# AI 実行先（OpenAI / Gemini / Anthropic の API）
#
# ⚠ 分担: **API キーはこのファイル**（他の外部サービスのキーと同じ置き場所）。
#    モデル名・推論オプション・どの用途をどの実行先で走らせるかは **設定画面**（DB）。
#
# 使う実行先の分だけ埋めればよい（空なら実行先の候補に出ない）。値を変えたら
# 設定キャッシュを使っている場合は `php artisan config:clear` が要る
#
# 1回の呼び出しの上限秒。既定 180 は他ジョブ（逆質問・ブリーフィング 600 秒、口コミ分割・条件抽出・
# メール取り込み 300 秒）と拡張の送信 TTL（200 秒）が CODEX_TIMEOUT=180 を前提にした固定値のため。
# 180 を超える値にするならそれらの見直しが要る。接続先は OPENAI_BASE_URL 等で上書きできる（通常は不要）
#
# ⚠ *_BASE_URL を書く場合はバージョンの区切りまで含める（既定は OpenAI が /v1、Gemini が /v1beta、
#   Anthropic が /v1）。ANTHROPIC_BASE_URL は各社公式 SDK と同名だが、SDK は /v1 を自分で足すのに対し
#   本アプリは足さない。SDK 向けに `https://api.anthropic.com`（/v1 なし）を設定していると 404 になる
#   この罠はシェルの環境変数からも来る。ANTHROPIC_BASE_URL はこのファイルに書かなくても、
#   起動したシェルに同名の変数があればそちらが優先される（Claude Code など他のツールが設定していることがある）。
#   Anthropic で 404 が出たら `printenv ANTHROPIC_BASE_URL` を確認する
# ─────────────────────────────────────────────────────────────
# API キーの取得先
#   OPENAI_API_KEY   : OpenAI ダッシュボード → API keys → Create new secret key（sk-proj-... 形式）
#   GEMINI_API_KEY   : Google AI Studio → Get API key。**課金を有効にしたプロジェクト**を選ぶ
#                      （無料枠のキーは送信内容が製品改善に使われ、人間のレビューも入る）
#   ANTHROPIC_API_KEY: Anthropic Console → API keys → Create Key（sk-ant-... 形式）
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_TIMEOUT=180
GEMINI_TIMEOUT=180
ANTHROPIC_TIMEOUT=180

# 判定エンジン（Jev / TypeSafe AI）。ウェイトリスト登録後にダッシュボードで発行。
# 判定エンジンを Jev にしない限り使われない（既定はオフ）。設定画面 → AIエンジン → 判定エンジン で実行先とモデルを選んで保存する。空で保存するとオフ（モデルは残る）
TYPESAFE_API_KEY=
TYPESAFE_TIMEOUT=10

# 1回の応答の出力上限（推論・思考トークン込み）。上限を送らないと長い生成が timeout に当たって
# usage を取れないまま切れ、「課金されたのに費用が出ない実行」になる。上限に当たった場合は
# 各社とも usage 付きで返るので「課金済みの失敗」として記録できる。
# 32000 は各社のモデル上限（OpenAI 128,000 / Gemini 65,536 / Anthropic 64k〜128k）より十分小さく、
# どのモデルでも通る値。上げるときは上の *_TIMEOUT も併せて見直す
OPENAI_MAX_OUTPUT_TOKENS=32000
GEMINI_MAX_OUTPUT_TOKENS=32000
# Anthropic の必須ヘッダ anthropic-version と、応答の上限トークン（上の2つと同じ役割。
# Anthropic では必須項目で、思考トークンも含むため budget_tokens はこれ未満である必要がある）
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=32000

# 拡張 extension/config.js の TOKEN と一致させる任意のランダム文字列
CLIP_TOKEN=

# AnalyzeCompanyJob の timeout(1500s)より大きく
DB_QUEUE_RETRY_AFTER=1600

# gBizINFO REST API トークン（無料。https://info.gbiz.go.jp/hojin/ の「Web-API」から発行）
# 認定(くるみん等)・補助金・調達実績の自動取得に使用。未設定なら該当ボタンがエラーを表示するだけ
GBIZINFO_API_TOKEN=

# EDINET API v2 の APIキー（無料。https://api.edinet-fsa.go.jp/ でアカウント登録して発行）
# 有報の平均年間給与・平均年齢・平均勤続年数・従業員数の自動取得に使用
EDINET_API_KEY=

# ─────────────────────────────────────────────────────────────
# Gmail からのメール取り込み（スカウト・日程調整）
#
# ⚠ OAuthクライアント・許可ドメイン・伏せ字は **このファイルに書かない**。
#    アプリの「設定 → Gmail連携」画面から入力する（暗号化して保存され、保存した瞬間に効く）。
#    画面にリダイレクトURIが表示されるので、それを Google Cloud 側へ登録する。
#
# ⚠ OAuth 同意画面の公開ステータスを「本番(In production)」にすること。
#    「テスト(Testing)」のままだとリフレッシュトークンが7日で失効し、毎週連携し直しになる。
#    gmail.readonly は制限付きスコープだが、利用者が本人のみなら審査は不要
#    （認可時に「確認されていないアプリ」の警告が出るので「詳細」→「移動」で進む）。
# ─────────────────────────────────────────────────────────────

# 取得する期間（日）。dev.sh を閉じていた間の分も次回起動時にまとめて拾うための窓
MAIL_FETCH_WINDOW_DAYS=7

# 1回の取得で処理する上限（1通=AI 1回のため歯止めを置く。APIを選んでいる場合はそのまま課金量になる）
MAIL_FETCH_MAX_MESSAGES=20
